@*
   _Layout.cshtml — shared layout for all views in this Tag Helpers tutorial.
   Provides:
     - Bootstrap 5 CDN for styling the alert tag helper demos
     - Navigation links using the anchor tag helper (asp-action, asp-controller)
     - @RenderBody() slot for view content
     - @RenderSection("Scripts", required: false) for optional per-view scripts
*@
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — Tag Helpers Tutorial</title>

    @* Bootstrap 5 CDN — provides styles for alert / form classes used in demos *@
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.2/css/bootstrap.min.css"
          integrity="sha512-b2QcS5SsA8tZodcDtGRELiGv5SaKSh1j68NrSjpuv5PFoJDcZZXwyq+4EtXYFCi9kbzA/q/+4oNitnVbdGSEQ=="
          crossorigin="anonymous" />
</head>
<body>
    @* Navigation bar using anchor tag helpers (asp-action, asp-controller) *@
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-4">
        <div class="container">
            <span class="navbar-brand">Tag Helpers Tutorial</span>
            <div class="collapse navbar-collapse">
                <ul class="navbar-nav">
                    <li class="nav-item">
                        @* asp-action / asp-controller → generates href at runtime *@
                        <a class="nav-link" asp-action="Forms" asp-controller="Demo">Forms</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-action="Navigation" asp-controller="Demo">Navigation</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-action="Assets" asp-controller="Demo">Assets</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-action="Custom" asp-controller="Demo">Custom</a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    @* Main content area — each view's HTML is inserted here *@
    <div class="container">
        @RenderBody()
    </div>

    @* Bootstrap JS bundle (required for dismissible alerts in the Custom demo) *@
    <script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.2/js/bootstrap.bundle.min.js"
            integrity="sha512-X/YkDZyjTf4wyc2Vy16YGCPHwAY8rZJY+POgokZjQB2mhIRFJCckEGc6YyX9eNsPfn0PzThEuNs+uaomE5CO6A=="
            crossorigin="anonymous"></script>

    @* Optional per-view scripts section — views render jQuery validate etc. here *@
    @RenderSection("Scripts", required: false)
</body>
</html>
