<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — TempData, ViewData & ViewBag</title>
    <style>
        *, *::before, *::after { box-sizing: border-box; }
        body   { font-family: Segoe UI, Arial, sans-serif; margin: 0; background: #f7f7f7; color: #222; }
        nav    { background: #1a1a2e; padding: 12px 24px; display: flex; gap: 20px; align-items: center; }
        nav a  { color: #e0e0e0; text-decoration: none; font-size: 0.95rem; }
        nav a:hover { color: #fff; text-decoration: underline; }
        nav .brand { color: #7ec8e3; font-weight: bold; margin-right: 10px; }
        main   { padding: 28px 32px; max-width: 860px; }
        h1     { margin-top: 0; }
        .alert { padding: 12px 16px; border-radius: 4px; margin-bottom: 18px; font-size: 0.95rem; }
        .alert-success { background: #d4edda; color: #155724; border-left: 4px solid #28a745; }
        .alert-error   { background: #f8d7da; color: #721c24; border-left: 4px solid #dc3545; }
        .alert-info    { background: #cce5ff; color: #004085; border-left: 4px solid #0d6efd; }
        .form-group    { margin-bottom: 16px; }
        label          { display: block; font-weight: 600; margin-bottom: 4px; }
        input[type=text], input[type=number] {
            width: 100%; max-width: 320px; padding: 7px 10px;
            border: 1px solid #bbb; border-radius: 4px; font-size: 1rem;
        }
        input:focus    { outline: 2px solid #0d6efd; border-color: #0d6efd; }
        .text-danger   { color: #dc3545; font-size: 0.85rem; margin-top: 3px; display: block; }
        .btn           { padding: 9px 20px; background: #0d6efd; color: #fff; border: none;
                         border-radius: 4px; cursor: pointer; font-size: 1rem; }
        .btn:hover     { background: #0a58ca; }
        .btn-secondary { background: #6c757d; }
        .btn-secondary:hover { background: #565e64; }
        table          { border-collapse: collapse; margin-top: 12px; }
        th, td         { border: 1px solid #ccc; padding: 8px 14px; text-align: left; }
        th             { background: #e9ecef; }
        code           { background: #eee; padding: 2px 5px; border-radius: 3px; font-size: 0.9rem; }
        pre            { background: #f1f3f5; padding: 14px; border-radius: 4px; overflow-x: auto;
                         font-size: 0.875rem; border-left: 3px solid #adb5bd; }
    </style>
</head>
<body>
    <nav>
        <span class="brand">MVC Data Demo</span>
        <a asp-controller="Products" asp-action="Index">Products</a>
        <a asp-controller="Products" asp-action="Create">Create Product</a>
        <a asp-controller="Demo"     asp-action="ViewDataDemo">ViewData / ViewBag Demo</a>
        <a asp-controller="Products" asp-action="PeekKeepDemo">Peek &amp; Keep Demo</a>
    </nav>
    <main>
        @RenderBody()
    </main>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
