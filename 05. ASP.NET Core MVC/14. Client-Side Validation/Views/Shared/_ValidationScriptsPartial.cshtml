@*
 * _ValidationScriptsPartial.cshtml — VALIDATION SCRIPTS PARTIAL
 *
 * FILE ROLE: Standard MVC partial that loads the three JavaScript libraries required
 *            for unobtrusive client-side validation, registers custom validator methods
 *            and adapters, and demonstrates re-parsing after dynamic DOM changes.
 *
 * SECTIONS IN THIS FILE:
 *   7. Required scripts: CDN, LibMan, Bundling
 *   8. Custom jQuery.validator.addMethod + unobtrusive adapters
 *   9. Re-validating after dynamic DOM changes with $.validator.unobtrusive.parse()
 *
 * Usage: included in a view's @section Scripts:
 *   @section Scripts {
 *       <partial name="_ValidationScriptsPartial" />
 *   }
 *
 * Why a partial?
 *   Validation scripts are only needed on pages with forms. Using a partial keeps
 *   the layout clean and avoids loading 3 extra scripts on every page. The pattern
 *   is the same one generated by "dotnet new mvc" scaffolding.
 *@

@*
 * SECTION 7: REQUIRED SCRIPTS — CDN / LibMan / Bundling
 *
 * jquery.js MUST already be on the page (loaded in _Layout.cshtml).
 * jquery.validate.js and jquery.validate.unobtrusive.js are loaded here.
 * Loading jquery.validate BEFORE unobtrusive is required — unobtrusive.js
 * extends the validate plugin and will throw if validate is not present.
 *
 * Option A — CDN (used here — easiest for tutorials and demos):
 *   Pro: no local files, no NuGet/LibMan config.
 *   Con: requires internet access at runtime; version pinned by URL.
 *
 * Option B — LibMan:
 *   1. Add libman.json to project root (or use VS > Add > Client-Side Library).
 *   2. Entry example:
 *        { "library": "jquery-validate@1.21.0", "destination": "wwwroot/lib/jquery-validate" }
 *   3. Replace CDN src with: src="~/lib/jquery-validate/jquery.validate.min.js"
 *   Pro: offline capable; version controlled with the project.
 *   Con: adds wwwroot/lib files to the repository.
 *
 * Option C — Bundling (BundleConfig + BuildBundlerMinifier):
 *   1. Add bundleconfig.json to project root.
 *   2. Define an output bundle:
 *        { "outputFileName": "wwwroot/bundles/validation.min.js",
 *          "inputFiles": ["wwwroot/lib/jquery-validate/jquery.validate.js",
 *                         "wwwroot/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.js"] }
 *   3. Replace two <script> tags with: <script src="~/bundles/validation.min.js"></script>
 *   Pro: single HTTP request; minified; cache-busting via asp-append-version.
 *   Con: requires BuildBundlerMinifier NuGet pkg; runs as MSBuild task.
 *@

<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.21.0/jquery.validate.min.js"
        integrity="sha512-KFHXdr2oObHKI9w4Hv1XPKc898mE4kgYx58oqsc/JqqdLMDI4YjOLzom+EMkRKVRS+NDXLoHkBqkk90cKstDA=="
        crossorigin="anonymous"
        referrerpolicy="no-referrer"></script>

<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/4.0.0/jquery.validate.unobtrusive.min.js"
        integrity="sha512-xq+Vm9jOtkFh4ea/HzZBTHCEkfQUlyCPl4a7bzRSqpMpqnTsLOCDTD9BNVsEBCkbVOqBUDkVwANQnLnLZHSw=="
        crossorigin="anonymous"
        referrerpolicy="no-referrer"></script>

<script>
    /*
     * SECTION 8: CUSTOM jQuery.validator.addMethod + UNOBTRUSIVE ADAPTERS
     *
     * Two steps are required to make a custom IClientModelValidator attribute
     * work on the client side:
     *
     *   STEP 1 — Register the validator method (the actual test function):
     *     jQuery.validator.addMethod(name, function(value, element[, params]) {
     *         return true;  // true = valid, false = invalid
     *     }, "Default error message if not supplied by the adapter");
     *
     *     name — must be lowercase; must match the key in data-val-{name}
     *     value — the current field value (string)
     *     element — the DOM element
     *     params — extra parameters from the adapter (if any)
     *
     *   STEP 2 — Register the adapter (maps data-val-* attrs → validator method):
     *     $.validator.unobtrusive.adapters.addBool(name)
     *
     * BOTH steps must run BEFORE $.validator.unobtrusive.parse() is called.
     * When scripts are in @@section Scripts the layout renders them AFTER
     * jquery.validate.unobtrusive.js, which calls parse() at document-ready —
     * so putting custom registration here (in the same partial, after the CDN scripts)
     * ensures the right order as long as the page is not cached with stale JS.
     *
     * Adapter helper methods:
     * ┌──────────────────────────────────────────────────────────────────────────────────┐
     * │ Method                        │ When to use                                     │
     * ├──────────────────────────────────────────────────────────────────────────────────┤
     * │ addBool(name)                 │ Boolean rule; data-val-{name} only; no params   │
     * │ addSingleVal(name, paramName) │ One extra param: data-val-{name}-{paramName}    │
     * │ addMinMax(n, minR, maxR,      │ Two params: min and max (like length, range)    │
     * │           minP, maxP)         │                                                  │
     * │ add(name, params[], fn)       │ Full control; fn receives options object        │
     * └──────────────────────────────────────────────────────────────────────────────────┘
     */

    // --- STEP 1: Register the "futuredate" validator method ---
    // Returns true (valid) if the value is empty (let [Required] handle that)
    // or if the parsed date is strictly after today.
    jQuery.validator.addMethod("futuredate", function (value, element) {
        if (!value || value.trim() === "") {
            return true; // defer to [Required]; no double error
        }
        var entered = new Date(value);
        var today = new Date();
        today.setHours(0, 0, 0, 0); // compare date only, ignoring time
        return !isNaN(entered.getTime()) && entered > today;
    }, "The date must be in the future.");

    // --- STEP 2: Register the unobtrusive adapter ---
    // addBool maps data-val-futuredate="message" → the "futuredate" method above.
    // The error message in the attribute overrides the default in addMethod.
    $.validator.unobtrusive.adapters.addBool("futuredate");

    /*
     * ADVANCED: addSingleVal example (if the attribute had an extra "minhours" param):
     *
     *   // C# AddValidation:
     *   //   MergeAttribute(ctx.Attributes, "data-val-futuredate-minhours", "24");
     *
     *   $.validator.unobtrusive.adapters.addSingleVal("futuredatehours", "minhours");
     *   jQuery.validator.addMethod("futuredatehours", function(value, element, minhours) {
     *       if (!value) return true;
     *       var d = new Date(value);
     *       var minMs = parseInt(minhours) * 3600000;
     *       return !isNaN(d.getTime()) && (d - new Date()) >= minMs;
     *   });
     *
     * ADVANCED: adapters.add() for full parameter control:
     *
     *   $.validator.unobtrusive.adapters.add("myvalidator", ["param1", "param2"],
     *       function (options) {
     *           options.rules["myvalidator"] = {
     *               param1: options.params.param1,
     *               param2: options.params.param2
     *           };
     *           options.messages["myvalidator"] = options.message;
     *       });
     */

    /*
     * SECTION 9: RE-VALIDATING AFTER DYNAMIC DOM CHANGES
     *
     * jquery.validate.unobtrusive calls $.validator.unobtrusive.parse(document) once
     * at document-ready. If you later inject new form fields (via AJAX, innerHTML,
     * Vue/React rendering, etc.) those fields are NOT parsed automatically — the
     * validator has no knowledge of them and silently skips them.
     *
     * Fix: call $.validator.unobtrusive.parse(container) on the container that holds
     * the new fields after inserting them.
     *
     * Important caveat: calling parse() on an already-parsed form does NOT re-attach
     * the validator. You must call it on the NEWLY INSERTED elements' container, not
     * on the whole form again. If you need to re-parse the whole form:
     *   1. Destroy the existing validator: $("form").removeData("validator").removeData("unobtrusiveValidation");
     *   2. Call: $.validator.unobtrusive.parse("form");
     *
     * Example — AJAX-loaded partial view injected into a container:
     */
    $(function () {
        // Simulate dynamic injection: a button reveals a hidden section.
        // In a real app this would be an AJAX callback.
        $("#load-dynamic-fields").on("click", function () {
            var $container = $("#dynamic-fields-container");

            // Inject a new required field dynamically (simulating AJAX-loaded HTML)
            $container.html(
                '<div class="form-group">' +
                '  <label for="DynamicField">Dynamic Field</label>' +
                '  <input id="DynamicField" name="DynamicField" type="text"' +
                '         data-val="true"' +
                '         data-val-required="Dynamic field is required." />' +
                '  <span data-valmsg-for="DynamicField" data-valmsg-replace="true"' +
                '        class="text-danger"></span>' +
                '</div>'
            );

            /*
             * Re-parse ONLY the newly injected container.
             * This registers the new field's data-val-* rules with the validator
             * so they are checked on the next submit or blur event.
             *
             * Passing the container (not the whole form) avoids re-processing
             * fields that are already registered.
             */
            $.validator.unobtrusive.parse($container);
        });

        /*
         * ENABLING / DISABLING UNOBTRUSIVE VALIDATION AT PAGE LEVEL:
         *
         * Disable for a specific form (e.g. a search form that should always submit):
         *   $("form#searchForm").data("validator", null);
         *   $("form#searchForm").removeData("unobtrusiveValidation");
         *
         * Globally ignore hidden fields (default: hidden fields are ignored):
         *   $.validator.setDefaults({ ignore: ":hidden" }); // default
         *   $.validator.setDefaults({ ignore: "" });         // validate hidden fields too
         *
         * Trigger full form validation programmatically (e.g. before an AJAX submit):
         *   var isValid = $("form").valid();
         *   if (isValid) { ... }
         */
    });
</script>
