<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — Model Binding MVC</title>
    <style>
        body { font-family: Segoe UI, Arial, sans-serif; max-width: 900px; margin: 0 auto; padding: 1rem; }
        nav a { margin-right: 1rem; }
        .field-validation-error { color: red; font-size: 0.85rem; }
        .validation-summary-errors ul { color: red; }
        input, select, textarea { margin-bottom: 0.5rem; display: block; }
        label { font-weight: bold; }
        .form-group { margin-bottom: 1rem; }
        .alert-success { background: #d4edda; border: 1px solid #c3e6cb; padding: 0.5rem 1rem; margin-bottom: 1rem; }
    </style>
</head>
<body>
    <nav>
        <a asp-controller="Orders" asp-action="Create">Create Order</a>
        <a asp-controller="Orders" asp-action="Search">Search</a>
        <a asp-controller="Orders" asp-action="Upload">Upload</a>
        <a asp-controller="Orders" asp-action="Index">All Orders</a>
    </nav>
    <hr />
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert-success">@TempData["SuccessMessage"]</div>
    }
    @RenderBody()
</body>
</html>
