{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "LoggingDiagnostics": "Debug",
      "LoggingDiagnostics.Services.OrderProcessingService": "Trace"
    },
    "Console": {
      "LogLevel": {
        "Default": "Information",
        "LoggingDiagnostics.Services": "Debug"
      },
      "FormatterName": "simple",
      "FormatterOptions": {
        "SingleLine": true,
        "IncludeScopes": true,
        "TimestampFormat": "HH:mm:ss "
      }
    },
    "Debug": {
      "LogLevel": {
        "Default": "Debug"
      }
    }
  },
  "AllowedHosts": "*"
}
